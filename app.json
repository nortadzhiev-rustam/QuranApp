{
  "expo": {
    "name": "QuranApp",
    "slug": "QuranApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "quranapp",
    "ios": {
      "bundleIdentifier": "com.rustamnortadzhiev.quran",
      "supportsTablet": true,
      "icon": "./assets/AppIcon.icon",
      "appleTeamId": "28QUF89Z2V"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rustamnortadzhiev.quran"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d5987528-75d3-45a0-9d37-708711944cce"
      }
    },
    "owner": "rustam-nortadzhiev",
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/react-native-vector-icons/Fonts/MaterialIcons.ttf",
              "./node_modules/react-native-vector-icons/Fonts/FontAwesome6_Solid.ttf",
              "./node_modules/react-native-vector-icons/Fonts/FontAwesome6_Regular.ttf",
              "./node_modules/react-native-vector-icons/Fonts/FontAwesome6_Brands.ttf"
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "image": "./assets/AppIcon.png"
        }
      ],
      "expo-status-bar"
    ]
  }
}
